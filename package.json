{
  "name": "smart-education",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "backend": "node --env-file-if-exists=backend/.env backend/server.mjs",
    "db:migrate:community": "node --env-file-if-exists=backend/.env backend/migrate-community.mjs",
    "test:progress": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/progress-metrics.test.mjs",
    "test:pomodoro": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/pomodoro-timer.test.mjs",
    "test:community": "node --test tests/community-api.test.mjs"
  },
  "dependencies": {
    "@expo/ui": "~58.0.25",
    "@expo/vector-icons": "^15.0.3",
    "@tanstack/react-query": "^5.90.0",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.17",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "^58.0.2",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "mysql2": "^3.24.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "^4.25.0",
    "react-native-svg": "^15.16.0",
    "react-native-web": "^0.21.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
